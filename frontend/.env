VITE_MAX_FETCH_LIMIT=100

## ROUTING URLS ##
VITE_DASHBOARD_URL=dashboard
# VITE_ALL_STUDENT_URL is the index path. Append it before every concurrent url Eg: students/findStudent,
VITE_ALL_STUDENT_URL=students
VITE_FIND_STUDENT_URL=findStudent
VITE_ADD_STUDENT_URL=addStudent
VITE_UPDATE_STUDENT_URL=updateStudent
# VITE_ADMIN_URL is the index path. Append it before every concurrent school,teacher,user url Eg: school/teachers
VITE_ADMIN_URL=school
# VITE_TEACHERS_URL is the index path. Append it before every concurrent url Eg: school/teachers/addTeacher
VITE_TEACHERS_URL=teachers
VITE_ADD_TEACHER_URL=addTeacher
VITE_UPDATE_TEACHER_URL=updateTeacher
# VITE_USERS_URL is the index path. Append it before every concurrent url Eg: school/users/addUser
VITE_USERS_URL=users
VITE_ADDUSER_URL=addUser

##DOMAIN FOR API##
API_DOMAIN=http://localhost:8810
## API URLS ##
VITE_DASHBOARD_LIST_API=${API_DOMAIN}/dashboard/latest-student-list
VITE_DASHBOARD_SUMMARY_API=${API_DOMAIN}/dashboard/student-summary
VITE_ALL_STUDENT_API=${API_DOMAIN}/student/active-students
VITE_FIND_STUDENT_API=${API_DOMAIN}/student/get-student-by-admissionNo
VITE_SEARCH_STUDENT_API=${API_DOMAIN}/student/search-student
VITE_ADD_STUDENT_API=${API_DOMAIN}/student/add-student
VITE_UPDATE_STUDENT_API=${API_DOMAIN}/student/update-student-details
